{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2018",
    "moduleResolution": "node",
    "allowJs": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "useUnknownInCatchVariables": true,
    "importHelpers": false,
    "lib": ["DOM", "DOM.Iterable", "ES2018"]
  },
  "include": ["src/**/*.ts"]
}
