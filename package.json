{
  "name": "paper-atlas",
  "version": "0.2.9",
  "description": "论文图谱：自绘论文画布与论文卡片仓",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test:core": "esbuild tests/run.ts --bundle --platform=node --format=cjs --outfile=/tmp/pa-core.cjs --log-level=warning && node /tmp/pa-core.cjs",
    "test:view": "esbuild tests/integration.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=/tmp/pa-view.cjs --log-level=warning && node /tmp/pa-view.cjs",
    "test": "npm run test:core && npm run test:view"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "0.25.5",
    "happy-dom": "^21.0.4",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.8.3"
  }
}
